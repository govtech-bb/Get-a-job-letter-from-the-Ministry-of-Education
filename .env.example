# Copy to .env.local and fill in. Never commit the filled-in version.

DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=onboarding@resend.dev

# Staging-only: redirect all outbound mail here (Resend free-tier only
# delivers to verified addresses). Unset once you have a verified sender
# domain and want letters to go to the actual employee.
RESEND_OVERRIDE_TO=

LETTER_SIGNING_KEY=change-me-to-a-random-32-byte-string
