{
  "name": "moe-letters",
  "version": "0.1.0",
  "private": true,
  "description": "Ministry of Education Job Letters — request and verify employment letters",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "build:ds": "node scripts/build-design-system.js",
    "check:ds": "node scripts/build-design-system.js --check",
    "build:pages": "node scripts/build-pages.js",
    "check:pages": "node scripts/build-pages.js --check",
    "build": "npm run build:ds && npm run build:pages",
    "test": "node --test test/*.test.js",
    "check": "npm run check:ds && npm run check:pages && npm test"
  },
  "dependencies": {
    "@govtech-bb/frontend": "1.0.0-alpha.29",
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "pg": "^8.21.0"
  }
}
