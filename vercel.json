{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/v",
      "destination": "/verify.html"
    },
    {
      "source": "/api/admin/settings/domains",
      "destination": "/api/admin/settings-domains.js"
    },
    {
      "source": "/letter-sent",
      "destination": "/api/letter-sent.js"
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
